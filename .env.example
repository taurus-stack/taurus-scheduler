# Taurus Scheduler environment variable template
# Copy to .env to use

# ====== Service Basic Info ======
APP_NAME=taurus-scheduler
LOG_LEVEL=INFO
SCHEDULER_INSTANCE_ID=scheduler-01
TIMEZONE=Asia/Shanghai

# ====== Shared Database (read-only access to taurus-backend database) ======
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=taurus
DB_NAME=taurus_backend
DB_TABLE_PREFIX=taurus_
DB_CHARSET=utf8mb4

# ====== Redis (distributed lock + task queue + deduplication) ======
# Field-level config takes priority; if REDIS_URL is set it overrides the fields below
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=AOADMIN3
REDIS_DB=2
# REDIS_URL=redis://:password@127.0.0.1:6379/2
REDIS_LOCK_PREFIX=taurus:scheduler:lock:
REDIS_QUEUE_KEY=taurus:scheduler:queue:script_task
REDIS_DEDUP_PREFIX=taurus:scheduler:dedup:

# ====== Scheduler Parameters ======
SCHEDULER_LEADER_LOCK_KEY=taurus:scheduler:leader
SCHEDULER_LEADER_LOCK_TTL=30
SCHEDULER_JOB_SYNC_INTERVAL=10
SCHEDULER_MISFIRE_GRACE_SECONDS=3600
SCHEDULER_DEDUP_TTL=600

# ====== Optional: Backend API callback fallback (used when queue consumer is not ready) ======
BACKEND_API_BASE_URL=http://127.0.0.1:8000
# BACKEND_API_TOKEN=xxxx-your-jwt-or-api-token

# ====== Health Check Port ======
HEALTH_HOST=0.0.0.0
HEALTH_PORT=9101